# Database
# Producción: usa MYSQL_URL si tu proveedor la entrega.
# Local: puedes usar DB_* o las variables MYSQL* del proveedor.
# Nota: MYSQLDATABASE y MYSQL_DATABASE son equivalentes aquí para compatibilidad.
MYSQL_URL=
MYSQL_PUBLIC_URL=
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLDATABASE=vitalia_v2
MYSQLUSER=root
MYSQLPASSWORD=
MYSQL_DATABASE=vitalia_v2
MYSQL_ROOT_PASSWORD=

DB_HOST=localhost
DB_PORT=3306
DB_NAME=vitalia_v2
DB_USER=root
DB_PASSWORD=
DB_PASS=

# App
APP_NAME=Vitalia
APP_ENV=development
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Mexico_City

# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Email
MAIL_DRIVER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@vitalia.app
MAIL_FROM_NAME=Vitalia

# Session
SESSION_LIFETIME=2592000
SESSION_SECURE=true

# Upload
MAX_FILE_SIZE=5242880
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif

# Support
SUPPORT_PHONE=442-XXX-XXXX
SUPPORT_EMAIL=ayuda@vitalia.app

# Security
JWT_SECRET=
ENCRYPTION_KEY=

# Frontend
REACT_APP_API_URL=http://localhost:8000/api

# Integración con neupsipro (módulo de Neuropsicología) ---------------------
NEUPSIPRO_BASE_URL=https://neurogolondrina.com
# Cuenta de SERVICIO en neupsipro (no es el correo de un paciente ni de un
# especialista real). Debe tener asignados los permisos:
#   - "user management" -> "consultation"
#   - "Tests"           -> "consultation"
NEUPSIPRO_SERVICE_USERNAME=
NEUPSIPRO_SERVICE_PASSWORD=
NEUPSIPRO_API_TIMEOUT=15
REACT_APP_ENV=development
